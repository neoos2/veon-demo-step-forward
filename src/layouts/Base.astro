---
import "../styles/tokens.css";
import "../styles/fonts.css";
import fontPreload from "../fonts/ibm-plex-sans-cyrillic-400-normal.woff2?url";
import "../styles/global.css";
import "../styles/home.css";

interface Props { lang: string; title: string; description: string; canonical?: string; }
const { lang, title, description, canonical } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="robots" content="noindex" />
    <link rel="preload" href={fontPreload} as="font" type="font/woff2" crossorigin />
    <style is:global>html, body { overflow-x: clip; }</style>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{lang.startsWith("uk") ? "До змісту" : lang.startsWith("ru") ? "К содержанию" : "Skip to content"}</a>
    <slot name="header" />
    <main id="main"><slot /></main>
    <slot name="footer" />
    <script src="../scripts/reveal.ts"></script>
    <script src="../scripts/main.ts"></script>
  </body>
</html>
